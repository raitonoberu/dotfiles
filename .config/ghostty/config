# visuals
theme = Rose Pine
font-family = Mononoki Nerd Font
font-size = 12
adjust-cell-height = 10%

# tabs
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>1=goto_tab:1
keybind = ctrl+a>2=goto_tab:2
keybind = ctrl+a>3=goto_tab:3
keybind = ctrl+a>4=goto_tab:4
keybind = ctrl+a>5=goto_tab:5

# splits
keybind = ctrl+a>v=new_split
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:down
keybind = ctrl+a>k=goto_split:up
keybind = ctrl+a>l=goto_split:right

# lifecycle
confirm-close-surface = false
keybind = ctrl+a>q=close_surface
keybind = ctrl+a>r=reload_config

# unbind
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
